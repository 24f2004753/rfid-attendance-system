      "name": "0. Faculty Authentication & RBAC",
      "description": "Role-Based Access Control endpoints for faculty and HOD logins.",
      "item": [
        {
          "name": "POST ME Faculty Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Authenticated as ME Faculty', function () {",
                  "    const data = pm.response.json();",
                  "    pm.expect(data.username).to.eql('me_faculty');",
                  "    pm.expect(data.department).to.eql('Mechanical Engineering');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"me_faculty\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Authenticates Mechanical Engineering faculty."
          },
          "response": []
        },
