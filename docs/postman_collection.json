            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Student created with status 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Returns student ID and valid fields', function () {",
                  "    const res = pm.response.json();",
                  "    pm.expect(res).to.have.property('id');",
                  "    pm.expect(res.name).to.eql('Vikramaditya Rao');",
                  "    pm.environment.set('createdStudentId', res.id);",
                  "});"
